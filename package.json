{
  "name": "agenthost",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "A universal local MCP server that gives AI agents safe, permissioned access to local computer capabilities.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "start:mcp": "node packages/mcp-server/dist/index.js",
    "smoke:mcp": "node scripts/smoke-mcp.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:notices": "node scripts/generate-third-party-notices.mjs",
    "release:scan": "node scripts/scan-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "benchmark:routing": "node scripts/benchmark-routing.mjs",
    "benchmark:desktop": "node scripts/benchmark-desktop.mjs",
    "release:install": "node scripts/install-release.mjs",
    "agenthost": "node packages/agenthost-cli/dist/index.js",
    "demo:overlay": "node scripts/demo-overlay.mjs",
    "demo:task-progress": "node scripts/task-progress-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.13.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
