{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "baseUrl": ".",
    "paths": {
      "@agenthost/core": [
        "packages/core/src/index.ts"
      ],
      "@agenthost/os-linux": [
        "packages/os-linux/src/index.ts"
      ],
      "@agenthost/app-overlay": [
        "packages/app-overlay/src/index.ts"
      ]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true
  }
}
